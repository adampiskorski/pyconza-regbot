{
  "python.testing.pytestArgs": ["."],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.linting.mypyEnabled": true,
  "python.linting.enabled": true,
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "off", // Use MyPy instead
  "python.formatting.provider": "none",
  "python.formatting.blackArgs": ["--line-length", "90"],
  "python.linting.mypyCategorySeverity.error": "Information",
  "mypy.runUsingActiveInterpreter": true,
  "python.analysis.indexing": true,
  "autoDocstring.docstringFormat": "google-notypes",
  "autoDocstring.generateDocstringOnEnter": true,
  "autoDocstring.guessTypes": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "files.associations": {
    "**/*.html": "jinja-html",
    "**/*.mjml": "mjml",
    "templates/**/*.txt": "jinja"
  },
  "[jinja][jinja-html]": {
    "editor.defaultFormatter": "monosans.djlint"
  },
  "[mjml]": {
    "editor.defaultFormatter": "mjmlio.vscode-mjml"
  },
  "html.format.templating": true,
  "emmet.includeLanguages": {
    "jinja-html": "html"
  },
  "djlint.blankLineAfterTag": ["endmacro", "import", "from", "extends"],
  "cSpell.words": [
    "LOGURU",
    "messageable",
    "mjml",
    "regbot",
    "unsubscription",
    "usertoken"
  ]
}
